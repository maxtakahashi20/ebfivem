# ========== Browser (prefixo VITE_) ==========
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# ========== Servidor (Cloudflare Worker — mesmo arquivo `.env`, injetado pelo Vite como bindings) ==========
# Se omitir SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY, o código usa os equivalentes VITE_* onde aplicável.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase → Project Settings → API → Secret key (formato sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# ========== Banco ==========
# Banco vazio: cole supabase/migrations/*_schema_completo_2de.sql no SQL Editor (ou npm run db:migrate).
# Banco com outras tabelas: supabase/reset-banco.sql APAGA todo o schema public e recria.
# db:migrate exige SUPABASE_DB_PASSWORD ou DATABASE_URL.
# SUPABASE_DB_PASSWORD=
# DATABASE_URL=postgresql://postgres:SENHA@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Chave única do painel /ADM2DE. Obrigatória: sem ela, ninguém entra.
ACCESS_KEY=

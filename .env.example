# ========== Browser (prefixo VITE_) ==========
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# ========== Servidor (Cloudflare Worker — mesmo arquivo `.env`, injetado pelo Vite como bindings) ==========
# Se omitir SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY, o código usa os equivalentes VITE_* onde aplicável.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase → Project Settings → API → Secret key (formato sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# ========== Banco (recomendado: SQL Editor) ==========
# Cole o arquivo inteiro supabase/schema.sql no Supabase → SQL Editor → Run.
# Opcional (CLI): npm run db:migrate — exige SUPABASE_DB_PASSWORD ou DATABASE_URL.
# SUPABASE_DB_PASSWORD=
# DATABASE_URL=postgresql://postgres:SENHA@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Painel /ADMCMF — se vazio, o código usa o padrão local documentado em código
ACCESS_KEY=

# ========== Discord OAuth (Perfil + identidade com tags) ==========
# Developer Portal → Application → OAuth2 → Redirect: http://localhost:8080/auth/discord/callback
# Scopes: identify, guilds, guilds.members.read
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_GUILD_ID=          # ID do SERVIDOR CMF (ícone do servidor → Copiar ID). Deve ser o MESMO servidor onde o bot foi adicionado.
# DISCORD_BOT_TOKEN=         # Bot → Reset Token. Adicione o bot AO SERVIDOR CMF (OAuth2 → URL Generator → bot; permissão Ver membros)
# Convite: https://discord.com/api/oauth2/authorize?client_id=SEU_CLIENT_ID&scope=bot
# Após mudar .env: reinicie npm run dev e clique SAIR DO DISCORD → entre de novo (ou ↻ ATUALIZAR CARGOS)
# Local: http://localhost:8080/auth/discord/callback
# Vercel: https://SEU-DOMINIO.vercel.app/auth/discord/callback
# DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback
# DISCORD_SESSION_SECRET=    # opcional — assina a sessão (padrão: ACCESS_KEY)

# ========== Alto Comando (gate de Logs, Sistema, Restrito e Suporte) ==========
# IDs dos cargos Discord que recebem acesso de Alto Comando. Separe por vírgula.
# Ex.: DISCORD_ALTO_COMANDO_ROLE_IDS=1234567890123456789,9876543210987654321
DISCORD_ALTO_COMANDO_ROLE_IDS=

# ========== Desenvolvedor (acesso pleno + badge "MODO DESENVOLVEDOR") ==========
# Cargos Discord com acesso total ao painel (vê tudo igual ao Alto Comando).
# Use apenas para você como dev. Separe múltiplos IDs por vírgula.
DISCORD_DESENVOLVEDOR_ROLE_IDS=

# ========== Discord Webhooks (NÃO precisa de bot — só o webhook do canal) ==========
# Discord → clique direito no canal → Editar canal → Integrações → Webhooks → Novo Webhook → Copiar URL
# A URL real tem NÚMEROS, por exemplo:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890123456789/AbCdEfGhIjKlMnOpQrStUvWxYz1234567890
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_ID/SEU_TOKEN
# Webhook separado para canal de logs admin (opcional — se vazio usa DISCORD_WEBHOOK_URL)
DISCORD_WEBHOOK_LOG_URL=
